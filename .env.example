# Copy to .env.local for local development. Never commit real values.
# Server-only: these are read by src/lib/env.ts and must never get a NEXT_PUBLIC_ prefix.

# Connection as ff_public_reader (published views + search_venues() only). Used by public pages and APIs.
DATABASE_URL_PUBLIC_READER=

# Connection as ff_admin_writer. Used only by authenticated /api/admin routes.
DATABASE_URL_ADMIN_WRITER=

# Operator only, never set in Vercel: the project owner connection (e.g. the `postgres` role) used by
# `pnpm admin:credential` to mint, rotate and revoke admin API credentials.
# Local: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_OPERATOR=

# Key that signs search pagination cursors: 32+ random bytes, e.g. `openssl rand -base64 48`.
# Rotating it only invalidates cursors already handed out.
SEARCH_CURSOR_SECRET=

# Supabase Storage via its S3 protocol (PR 2.12). Server-only. S3 access keys reach Storage only.
# Hosted: Project settings → Storage → S3 connection (enable it, then create an access key).
# Local: `pnpm db:status` prints them; the endpoint is http://127.0.0.1:54321/storage/v1/s3, region "local".
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Public media bucket base URL (not secret): <project URL>/storage/v1/object/public/media-public
MEDIA_PUBLIC_BASE_URL=

# Optional: set to "debug" for verbose server logs.
LOG_LEVEL=
